# EconoCausal Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Python Application Settings
PYTHONPATH=.
LOG_LEVEL=INFO
RANDOM_SEED=42

# Data Paths (optional overrides)
DATASET_PATH=sample_data/synthetic_retail_campaign.csv
MODEL_OUTPUT_DIR=models
REPORTS_OUTPUT_DIR=reports

# Frontend Development Server Settings
VITE_PORT=5173
VITE_HOST=localhost
